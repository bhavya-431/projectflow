# ==============================================================================
# ProjectFlow Environment Variables
# ==============================================================================
# When configured with your Supabase Project credentials, ProjectFlow connects
# directly to your PostgreSQL database with Row Level Security (RLS) and Supabase Auth.
#
# If left empty or missing, ProjectFlow automatically runs in interactive Local/Demo mode
# with realistic mock data and persistent localStorage state so you can test immediately.
# ==============================================================================

# Your Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Public Anonymous Key / Publishable Key (safe for client side)
# NEVER put the service_role key here!
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
